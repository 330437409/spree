+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!parsed || typeof parsed !== "object") return undefined;
+
+    const { state, returnTo } = parsed as Partial<SocialLoginContext>;
+    if (typeof state !== "string") return undefined;
