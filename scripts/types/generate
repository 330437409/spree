#!/usr/bin/env bash
# Regenerates the SDK types and Zod schemas from the serializers, wherever they
# live — core's and the extension gems'.
#
# It has to run in an application that loads *every* fork gem, because Typelizer
# prunes the directories it writes: a run from spree/api alone would delete the
# extension gems' types rather than leave them. That application is the starter,
# so this runs there — inside the Docker service when that is how the stack is
# running, directly when it is not.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

if [ ! -d server ]; then
  echo "scripts/types/generate: no server/ checkout — the types are generated in the" >&2
  echo "starter application, which must have every extension gem installed." >&2
  exit 1
fi

echo "Generating types from the serializers (this needs every gem loaded)…"
if docker compose -f server/docker-compose.yml ps --status running --services 2>/dev/null | grep -qx web; then
  docker compose -f server/docker-compose.yml exec -T web bin/rails typelizer:generate
else
  (cd server && bundle exec rake typelizer:generate)
fi

# The Zod schemas follow the TS types, and pnpm is a host tool either way.
(cd packages/sdk && pnpm generate:zod)

git add packages/sdk/src/types/generated packages/sdk/src/zod/generated \
        packages/admin-sdk/src/types/generated packages/seller-sdk/src/types/generated
echo "Types regenerated and staged."
